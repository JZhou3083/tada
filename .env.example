# Directory used for local runtime state such as traces, checkpoints and run metadata.
# Defaults to the platform-specific user app state directory if not provided.
TADA_STATE_DIR="./.tada"

# Which LLM backend to use for all graph generation calls.
# One of: google_vertex, openai, anthropic, deepseek. Defaults to "openai".
TADA_LLM_PROVIDER="openai"

# API keys — only the one matching TADA_LLM_PROVIDER needs to be set.
TADA_OPENAI_API_KEY=""
TADA_ANTHROPIC_API_KEY=""
TADA_DEEPSEEK_API_KEY=""
TADA_DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Arguments used when instantiating the GenAI SDK client. Only relevant when
# TADA_LLM_PROVIDER=google_vertex.
TADA_CLIENT_PROJECT="jlr-dl-cat"
TADA_CLIENT_LOCATION="global"

# Graph settings can be configured using environment variables.
# NOTE: these must be valid model IDs for whichever TADA_LLM_PROVIDER is selected —
# the Gemini model names below only resolve against google_vertex. Switching
# provider requires switching these to that provider's own model IDs.
TADA_GRAPH__SECTION_DOCUMENTER__DOCUMENTATION_MODEL="gemini-3-flash-preview"
TADA_GRAPH__SECTION_DOCUMENTER__EVALUATION_MODEL="gemini-3-flash-preview"
TADA_GRAPH__SECTION_DOCUMENTER__MAX_DOCUMENTATION_RETRIES=2

TADA_GRAPH__WORKBOOK_DOCUMENTER__SUMMARY_MODEL="gemini-3-flash-preview"
