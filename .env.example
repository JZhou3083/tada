# Directory used for local runtime state such as traces, checkpoints and run metadata.
# Defaults to the platform-specific user app state directory if not provided.
TADA_STATE_DIR="./.tada"

# Arguments used when instantiating the GenAI SDK client - these MUST be provided.
TADA_CLIENT_PROJECT="jlr-dl-cat"
TADA_CLIENT_LOCATION="global"

# Graph settings can be configured using environment variables.
# The following defaults are used if no environment variables are supplied.
TADA_GRAPH__SECTION_DOCUMENTER__DOCUMENTATION_MODEL="gemini-3-flash-preview"
TADA_GRAPH__SECTION_DOCUMENTER__EVALUATION_MODEL="gemini-3-flash-preview"
TADA_GRAPH__SECTION_DOCUMENTER__MAX_DOCUMENTATION_RETRIES=2

TADA_GRAPH__WORKBOOK_DOCUMENTER__SUMMARY_MODEL="gemini-3-flash-preview"
